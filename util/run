#! /bin/sh
. "$(dirname "$0")/config.sh"

CMD="docker run"
ARGS="$@"

if isempty ARGS; then
    ARGS="--name $CONTAINER_NAME"
fi

# ------------------------------------------------------------------
# ROS 2 / Zenoh configuration
# ------------------------------------------------------------------

append ARGS \
    -e "TERM=xterm-256color" \
    -e "RMW_IMPLEMENTATION=rmw_zenoh_cpp" \
    -e "ROS_DOMAIN_ID=0"

# WSL: connect to the Linux Zenoh router.
# Native Linux host: don't force a Zenoh client configuration.
if [ -n "$WSL_DISTRO_NAME" ]; then
    # append() uses eval, so escape the JSON5 quotes.
    ZENOH_CONFIG='mode=\"client\";connect/endpoints=[\"tcp/10.0.8.195:7447\"]'

    append ARGS \
        -e "ZENOH_CONFIG_OVERRIDE=$ZENOH_CONFIG"
fi

append ARGS \
    -it \
    -v "$SHARED_VOLUME" \
    --rm

if ! (istrue DEV || is_darwin); then
    append ARGS \
        -v "/dev:/dev" \
        --privileged \
        --network host
else
    # :7447 (Zenoh)
    # :8765 (Foxglove)
    append ARGS \
        -p 7447:7447 \
        -p 8765:8765
fi

append ARGS \
    "$IMAGE_TAG"

call $CMD $ARGS