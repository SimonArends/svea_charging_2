<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>svea_charging</name>
  <version>0.0.0</version>
  <description>Charging behavior, docking controllers, and indoor charging demo launch files for SVEA.</description>
  <maintainer email="kajarf@kth.se">Kaj Munhoz Arfvidsson</maintainer>
  <license>TODO: License declaration</license>

  <depend>svea_core</depend>
  <depend>cv_bridge</depend>
  <depend>geometry_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf_transformations</depend>
  <depend>usb_cam</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
